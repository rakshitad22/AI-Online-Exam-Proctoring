PROJECT_NAME="AI Online Exam Proctoring System"
API_V1_STR="/api/v1"
SECRET_KEY="ai-proctoring-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="ai_proctoring_db"
FRONTEND_URL="http://localhost:5173"

# AI Proctoring & Detection Parameters
FRAME_INTERVAL=3.0
CONFIDENCE_THRESHOLD=0.50
PHONE_CONFIDENCE_THRESHOLD=0.60
CONSECUTIVE_FRAMES_REQUIRED=2
HEAD_MOVEMENT_THRESHOLD=0.22
TALKING_THRESHOLD=0.35
MAX_WARNINGS=3

# Web Audio API RMS Monitoring
AUDIO_THRESHOLD_RMS=0.25
