# Risk Weights
WEIGHT_HEAD_MOVEMENT=5
WEIGHT_TALKING=10
WEIGHT_BACKGROUND_NOISE=15
WEIGHT_EXTERNAL_DEVICE=25
WEIGHT_MULTIPLE_PERSONS=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8008"]
